{
	"compilerOptions": {
		"target": "ESNext",
		"module": "NodeNext",
		"lib": ["ESNext", "dom"],
		"moduleResolution": "NodeNext",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"strict": true,
		"strictNullChecks": true,
		// The CAR builder imports `ipfs-car`, which pulls in transitive `.d.ts`
		// files (`@ipld/unixfs`, `actor`) that don't themselves pass strict `tsc`.
		// skipLibCheck typechecks OUR code fully while not re-typechecking third-
		// party declaration files (the near-universal TS convention). It changes
		// no runtime behaviour and no public surface. See the `car-build` task.
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"allowImportingTsExtensions": false,
		"rootDir": "./src",
		"outDir": "./dist"
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
