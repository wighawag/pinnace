{
	"name": "pinnace",
	"version": "0.8.1",
	"license": "AGPL-3.0-only",
	"description": "Self-host a static website on IPFS across one or more self-owned Kubo nodes.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wighawag/pinnace.git",
		"directory": "packages/pinnace"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"bin": {
		"pinnace": "./dist/cli/bin.js"
	},
	"files": [
		"dist",
		"src"
	],
	"dependencies": {
		"files-from-path": "^1.1.4",
		"ipfs-car": "^3.1.0",
		"ldenv": "^0.3.16"
	},
	"devDependencies": {
		"@ipld/car": "^5.4.6",
		"@ipld/dag-pb": "^4.1.7",
		"@types/node": "^25.2.0",
		"as-soon": "^0.1.5",
		"tsx": "^4.21.0",
		"typescript": "^5.3.3",
		"vitest": "^4.0.18"
	},
	"scripts": {
		"build": "tsc",
		"dev": "as-soon -w src pnpm build",
		"test": "vitest run",
		"test:watch": "vitest"
	}
}
