{
	"name": "pinnace",
	"version": "0.0.0",
	"license": "AGPL-3.0-only",
	"description": "Self-host a static website on IPFS across one or more self-owned Kubo nodes.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"bin": {
		"pinnace": "./dist/cli/bin.js"
	},
	"files": [
		"dist",
		"src"
	],
	"dependencies": {},
	"devDependencies": {
		"@types/node": "^25.2.0",
		"as-soon": "^0.1.5",
		"tsx": "^4.21.0",
		"typescript": "^5.3.3",
		"vitest": "^4.0.18"
	},
	"scripts": {
		"build": "tsc",
		"dev": "as-soon -w src pnpm build",
		"test": "vitest run",
		"test:watch": "vitest"
	}
}
